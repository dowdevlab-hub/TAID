# Optional. Without this key, the MVP structures the user's actual transcript
# with transparent deterministic rules and keeps the full D1 workflow available.
# Keep the key server-only and never expose it through NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional model override used only when OPENAI_API_KEY is configured.
OPENAI_MODEL=gpt-5-mini

# D1 is provided by the Sites DB binding declared in .openai/hosting.json.
# No database URL, Supabase account, or Supabase key is required here.
